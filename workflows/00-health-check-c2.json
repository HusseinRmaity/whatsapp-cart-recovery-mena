      {
        "id": "build-response",
        "name": "Build Health Response",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          960,
          300
        ],
        "parameters": {
          "jsCode": "function statusOf(nodeName) {\n  try {\n    const item = $(nodeName).first();\n    if (!item) return { status: 'unknown' };\n    const j = item.json || {};\n    if (j.error) {\n      const msg = typeof j.error === 'string' ? j.error : JSON.stringify(j.error);\n      return { status: 'unreachable', detail: msg.slice(0, 200) };\n    }\n    return { status: 'reachable', json: j };\n  } catch (e) {\n    return { status: 'unreachable', detail: String(e && e.message ? e.message : e).slice(0, 200) };\n  }\n}\n\nconst a = statusOf('Check Anthropic API');\nconst s = statusOf('Check Supabase REST');\nconst p = statusOf('Check Shopify Admin API');\n\n// Shopify returns 200 with an errors[] on scope problems - treat that as unreachable\nif (p.status === 'reachable' && p.json && p.json.errors) {\n  p.status = 'unreachable';\n  p.detail = JSON.stringify(p.json.errors).slice(0, 200);\n}\n\nconst shopName = (p.json && p.json.data && p.json.data.shop) ? p.json.data.shop.name : null;\nconst modelCount = (a.json && Array.isArray(a.json.data)) ? a.json.data.length : null;\n\nconst checks = {\n  anthropic: { status: a.status, models_visible: modelCount, detail: a.detail || undefined },\n  supabase:  { status: s.status, detail: s.detail || undefined },\n  shopify:   { status: p.status, store: shopName, detail: p.detail || undefined }\n};\n\nconst allOk = Object.values(checks).every(c => c.status === 'reachable');\n\nreturn [{ json: {\n  status: allOk ? 'ok' : 'degraded',\n  service: 'case-2-abandoned-cart-recovery',\n  timestamp: new Date().toISOString(),\n  checks\n}}];"
        }
      },
